# Optional settings for your copy of Tristakfy.
# Copy this file to ".env" (same folder) and change what you need. ".env" is never put in git,
# so it stays on your PC. Lines starting with # are ignored.

# Where your playlists, likes, play stats, chart history and cover cache are kept.
# Default: the "data" folder inside the app (git ignores it). A relative path is relative to this folder,
# e.g. ..\my-data keeps your data next to the app folder instead of inside it.
# DATA_DIR=..\my-data

# Who can open your server. Default 127.0.0.1 = only this PC (your phone reaches it through
# "tailscale serve", which counts as this PC). 0.0.0.0 = any device on your network can open it,
# and see and change your library, so only do that together with ACCESS_KEY.
# HOST=127.0.0.1

# A password for every request (the app asks for it once per device, under Settings -> Servers).
# ACCESS_KEY=

# The port to start from (the next free one is used if it's taken).
# PORT=8000
